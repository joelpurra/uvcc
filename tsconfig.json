{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "noPropertyAccessFromIndexSignature": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "erasableSyntaxOnly": false
  },
  "exclude": ["node_modules", "dist"],
  "extends": "@sindresorhus/tsconfig"
}
